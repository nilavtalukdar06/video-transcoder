# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Postgres (consumed by docker-compose)
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=video_transcoder
POSTGRES_PORT=5432

# Postgres connection string (consumed by the app / drizzle)
DATABASE_URL=postgres://app:app_password@localhost:5432/video_transcoder

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Session
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL=86400
SESSION_COOKIE_NAME=sid

# Rate limiter (global)
RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION=60

# AWS S3 (video uploads)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ClickHouse (transcoder logs written by apps/logs-consumer)
CLICKHOUSE_URL=
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
