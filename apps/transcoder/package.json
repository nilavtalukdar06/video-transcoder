{
  "name": "@video-transcoder/transcoder",
  "version": "1.0.0",
  "description": "TypeScript (ESM) Node.js transcoder service that runs ffmpeg",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "typescript",
    "esm",
    "ffmpeg",
    "transcoder"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@t3-oss/env-core": "^0.13.11",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.38.3",
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  }
}
