NODE_ENV=development

AWS_REGION=us-east-1
# Bucket the original video lives in (it is deleted after a successful run)
AWS_S3_BUCKET=
# Bucket the 360p/480p/720p/1080p renditions are written to
AWS_S3_TRANSFORMED_BUCKET=video-transcoder-transformed

# Local runs only. On ECS leave unset so the task role is used.
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
