NODE_ENV=development

# Postgres connection string (must be reachable from the ECS task)
DATABASE_URL=postgres://app:app_password@localhost:5432/video_transcoder

AWS_REGION=us-east-1
# Bucket the original video lives in (it is deleted after a successful run)
AWS_S3_BUCKET=
# Bucket the 360p/480p/720p/1080p renditions are written to
AWS_S3_TRANSFORMED_BUCKET=video-transcoder-transformed

# Local runs only. On ECS leave unset so the task role is used.
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# Kafka (logs produced by processLogs). KAFKA_SSL needs ./ca.pem next to package.json
KAFKA_BROKER=
KAFKA_SSL=true
KAFKA_SASL=true
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_LOGS_TOPIC=transcoding-logs
