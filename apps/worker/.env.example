# Application
NODE_ENV=development
PORT=4000

# Postgres connection string
DATABASE_URL=postgres://app:app_password@localhost:5432/video_transcoder

# AWS S3
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# AWS SQS queue the worker consumes
SQS_URL=

# ECS task the worker runs for every uploaded video
ECS_CLUSTER=
ECS_TASK_DEFINITION=
# Container name inside the task definition
ECS_CONTAINER_NAME=transcoder
# Comma-separated subnet and security group ids
ECS_SUBNETS=
ECS_SECURITY_GROUPS=
# ENABLED when the subnets are public and the task needs to pull its image
ECS_ASSIGN_PUBLIC_IP=ENABLED
