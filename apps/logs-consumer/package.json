{
  "name": "@video-transcoder/logs-consumer",
  "version": "1.0.0",
  "description": "Express + TypeScript (ESM) background worker that consumes transcoder logs from Kafka",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "express",
    "typescript",
    "esm",
    "worker",
    "kafka"
  ],
  "license": "MIT",
  "dependencies": {
    "@clickhouse/client": "^1.24.1",
    "@t3-oss/env-core": "^0.13.11",
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "kafkajs": "^2.2.4",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
