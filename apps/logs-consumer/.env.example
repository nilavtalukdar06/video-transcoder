# Application
NODE_ENV=development
PORT=4100

# Kafka (logs produced by apps/transcoder). KAFKA_SSL needs ./ca.pem next to package.json
KAFKA_BROKER=
KAFKA_SSL=true
KAFKA_SASL=true
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_LOGS_TOPIC=transcoding-logs
KAFKA_GROUP_ID=logs-consumer

# ClickHouse (log_events table, see src/logs/log-events.sql)
CLICKHOUSE_URL=
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
